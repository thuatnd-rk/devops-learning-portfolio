{
  "id": null,
  "title": "Container Monitoring Overview",
  "tags": ["containers", "cadvisor", "monitoring"],
  "style": "dark",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total[5m]) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Memory Usage by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "unitScale": "MB"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Network I/O by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total[5m])",
          "legendFormat": "{{name}} - RX",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total[5m])",
          "legendFormat": "{{name}} - TX",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "unitScale": "MB"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Disk Usage by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "container_fs_usage_bytes",
          "legendFormat": "{{name}} - Used",
          "refId": "A"
        },
        {
          "expr": "container_fs_limit_bytes",
          "legendFormat": "{{name}} - Limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "unitScale": "MB"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "Disk I/O Operations by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_fs_reads_total[5m])",
          "legendFormat": "{{name}} - Reads",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_total[5m])",
          "legendFormat": "{{name}} - Writes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "Disk I/O Bytes by Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total[5m])",
          "legendFormat": "{{name}} - Read Bytes",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total[5m])",
          "legendFormat": "{{name}} - Write Bytes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "unitScale": "MB"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 7,
      "title": "Container Disk Summary",
      "type": "table",
      "targets": [
        {
          "expr": "container_fs_usage_bytes",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "name": "Container",
              "container": "Container ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 27,
  "version": 1
}